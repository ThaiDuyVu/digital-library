# Copy thành .env rồi chỉnh nếu cần
MONGO_PORT=27017
MONGO_DB=digital_library
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

REDIS_PORT=6379
REDISINSIGHT_PORT=5540
MONGO_EXPRESS_PORT=8081

# Chuỗi kết nối dùng trong backend (chạy ngoài Docker)
MONGO_URI=mongodb://admin:admin123@localhost:27017/digital_library?authSource=admin
REDIS_URL=redis://localhost:6379

# Tài khoản quản trị tạo khi backend khởi động lần đầu (đổi khi demo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@digital-library.local
